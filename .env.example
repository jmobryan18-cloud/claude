# Gattitown Asset Management — Environment Configuration
# Copy this to .env and adjust for your TrueNAS setup

# Port the app listens on (default: 3000)
PORT=3000

# Path on the NAS where the SQLite database is stored
# TrueNAS SCALE mounts pools under /mnt/
# Example: /mnt/HDDs/Applications/Justinsapp/data
DATA_PATH=./data

# Path on the NAS where photos are stored
# Example: /mnt/HDDs/Applications/Justinsapp/data/photos
PHOTOS_PATH=./data/photos
